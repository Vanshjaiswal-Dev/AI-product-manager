# ─────────────────────────────────────────────
#  AI Product Manager — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Your Google Gemini API key
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string
# Local example : mongodb://localhost:27017/ai-product-manager
# Atlas example : mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-product-manager
MONGO_URI=your_mongo_connection_string_here

# Port the Express server will listen on
PORT=5000
