# ─────────────────────────────────────────────
#  AI Product Manager — Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development   # set to 'production' when deployed

# MongoDB connection string
# Local example : mongodb://localhost:27017/ai-product-manager
# Atlas example : mongodb+srv://<user>:<pass>@cluster.mongodb.net/ai-product-manager
MONGO_URI=your_mongo_connection_string_here

# JSON Web Token secret — used to sign short-lived access tokens (15 min)
JWT_SECRET=your_super_secret_jwt_key_here

# Refresh token secret — used to sign long-lived refresh tokens (7 d)
# Falls back to JWT_SECRET + '_refresh' if omitted (fine for dev, set explicitly in prod!)
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here


# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Override which Gemini model is used first in the fallback chain
# Defaults to gemini-2.0-flash-lite if omitted
GEMINI_MODEL=gemini-2.0-flash-lite

# Frontend origin for CORS (no trailing slash)
# Local  : http://localhost:5173
# Prod   : https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
